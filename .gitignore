# Data rules -- data/ holds curated inputs only. Everything tracked is whitelisted
# explicitly here; anything else under data/ is local (e.g. data/articles/, ~160 MB of PDFs).
data/*
!data/README.md
!data/keys/
!data/keys/**
!data/schemas/
!data/schemas/**
!data/lit/
!data/species/
!data/benchmarks/
!data/protocols/
!data/protocols/**
!data/research_corpus/
!data/research_corpus/**
!data/formulation_grid.yml
!data/interventions.yml

# Bulky & auto-generated data exclusions
data/lit/*.pdf
data/lit/**/*.pdf

# Test Reports and Validation Evidence
reports/
results/*
!results/validation/
!results/validation/**
!results/literature/
!results/literature/*.json
!results/maillard_results.db
!results/README.md
!results/legacy_lane/README.md

